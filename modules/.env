# ============================================================
# Global environment variables for the SMTP toolkit
# ============================================================

# Default number of accounts to configure
COUNT=2

# Strict validation (1 = yes, 0 = no)
STRICT_VALIDATION=1

# Dry-run mode (1 = preview config in /tmp/msmtprc.preview)
DRY_RUN=1

# Default account name (if not chosen interactively)
DEFAULT_ACCOUNT=gmail

# Email address for SMTP test sends
SMTP_TEST_TO=recipient@example.com

# Automatically run SMTP test at the end of config_generator.sh
RUN_SMTP_TEST=1
