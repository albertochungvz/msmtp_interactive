# =========================
# Sensitive files
# =========================

# msmtp password files
/etc/msmtp/*.pw
*.pw

# Local configurations that may contain real data
/etc/msmtprc
msmtprc
config/msmtprc.local
config/*.local

# =========================
# Execution logs and outputs
# =========================

# msmtp logs
/var/log/msmtp/*.log
*.log

# Temporary test files
tmp/
*.tmp
/tmp/*

# =========================
# System and environment files
# =========================

# System files
.DS_Store
Thumbs.db

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo

# =========================
# Backup files
# =========================
*~
*.bak
*.old

# =========================
# Others
# =========================

# Automated test outputs
test/output/
# Temporary test files
msmtp-test.*