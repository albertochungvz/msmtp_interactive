# Account name (must match filename)
ACCOUNT_NAME=gmail

# Preset to use (must exist in smtp_presets.sh or "custom")
ACCOUNT_PRESET=gmail

# From address
ACCOUNT_FROM=user@gmail.com

# SMTP username
ACCOUNT_USER=user@gmail.com

# Path to password file (stored securely in /etc/msmtp.secrets)
ACCOUNT_SECRET=/etc/msmtp.secrets/gmail.passwd
