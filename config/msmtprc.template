# =========================
# Configuración global
# =========================
defaults
auth                 on
tls                  on
# Cambiar a 'off' si usas SMTPS puro (puerto 465)
tls_starttls         on
tls_trust_file       /etc/ssl/certs/ca-certificates.crt
tls_certcheck        on
logfile              /var/log/msmtp/msmtp.log
aliases              /etc/aliases

# Fuerza la inclusión de la cabecera From: (requiere msmtp >= 1.8.8)
# El script principal activará esta línea si la versión lo soporta
#set_from_header      on

# =========================
# Cuenta por defecto
# =========================
account              default
host                 {{SMTP_HOST}}
port                 {{SMTP_PORT}}
from                 {{FROM_ADDR}}
# El script principal activará esta línea si la versión lo soporta
#from_full_name       "{{FROM_NAME}}"
user                 {{SMTP_USER}}
passwordeval         "cat /etc/msmtp/{{SECRET_FILE}}"

# =========================
# Notas:
# - Sustituye {{VARIABLE}} por valores reales o deja que el script lo haga.
# - Usa un archivo de contraseña por cuenta, con permisos 600 y propietario root:root.
# - Para cuentas adicionales, copia el bloque 'account' y cambia los valores.
# - No incluyas comentarios al final de las líneas de configuración: ponlos en líneas separadas.
